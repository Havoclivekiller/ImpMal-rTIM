<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">
    {{#if actor.defendingAgainst}}
    {{> defendingAgainst data=actor.defendingAgainst}}
    {{/if}}
    <div class="ship-combat-actions">
        <div class="ship-combat-actions-group">
            <div class="ship-combat-actions-buttons">
                {{#if notMinion}}
                <button type="button" class="ship-combat-action" data-action="makeTest" data-type="repair" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Repair"}}"><i class="fa-solid fa-screwdriver-wrench"></i>{{localize "IMPMAL_RTIM.VoidCombat.Repair"}} 
                {{#if system.actionCosts.repair.value}}({{system.actionCosts.repair.value}} {{localize "IMPMAL_RTIM.VoidCombat.AP"}}){{/if}}</button>
                <button type="button" class="ship-combat-action" data-action="makeTest" data-type="rally" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Rally"}}"><i class="fa-solid fa-person-harassing"></i>{{localize "IMPMAL_RTIM.VoidCombat.Rally"}} 
                {{#if system.actionCosts.rally.value}}({{system.actionCosts.rally.value}} {{localize "IMPMAL_RTIM.VoidCombat.AP"}}){{/if}}</button>
                <button type="button" class="ship-combat-action" data-action="makeTest" data-type="scan" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Scan"}}"><i class="fa-solid fa-satellite-dish"></i>{{localize "IMPMAL_RTIM.VoidCombat.Scan"}} 
                {{#if system.actionCosts.scan.value}}({{system.actionCosts.scan.value}} {{localize "IMPMAL_RTIM.VoidCombat.AP"}}){{/if}}</button>
                <button type="button" class="ship-combat-action" data-action="makeTest" data-type="boarding" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Boarding"}}"><i class="fa-solid fa-person-rifle"></i>{{localize "IMPMAL_RTIM.VoidCombat.Boarding"}} 
                {{#if system.actionCosts.boarding.value}}({{system.actionCosts.boarding.value}} {{localize "IMPMAL_RTIM.VoidCombat.AP"}}){{/if}}</button>
                <button type="button" class="ship-combat-action" data-action="makeTest" data-type="reloadSpecial" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.ReloadSpecial"}}"><i class="fa-solid fa-rotate-right"></i>{{localize "IMPMAL_RTIM.VoidCombat.ReloadSpecial"}} 
                {{#if system.actionCosts.reloadSpecial.value}}({{system.actionCosts.reloadSpecial.value}} {{localize "IMPMAL_RTIM.VoidCombat.AP"}}){{/if}}</button>
                <button type="button" class="ship-combat-action" data-action="makeTest" data-type="restartShields" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.RestartShields"}}"><i class="fa-solid fa-shield-virus"></i>{{localize "IMPMAL_RTIM.VoidCombat.RestartShields"}} 
                {{#if system.actionCosts.restartShields.value}}({{system.actionCosts.restartShields.value}} {{localize "IMPMAL_RTIM.VoidCombat.AP"}}){{/if}}</button>
                <button type="button" class="ship-combat-action" data-action="makeTest" data-type="seek" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Seek"}}"><i class="fa-brands fa-cloudscale"></i>{{localize "IMPMAL_RTIM.VoidCombat.Seek"}} 
                {{#if system.actionCosts.seek.value}}({{system.actionCosts.seek.value}} {{localize "IMPMAL_RTIM.VoidCombat.AP"}}){{/if}}</button>
                <button type="button" class="ship-combat-action" data-action="makeTest" data-type="evasiveManeuvers" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.EvasiveManeuvers"}}"><i class="fa-solid fa-arrows-turn-to-dots"></i>{{localize "IMPMAL_RTIM.VoidCombat.EvasiveManeuvers"}} 
                {{#if system.actionCosts.evasiveManeuvers.value}}({{system.actionCosts.evasiveManeuvers.value}} {{localize "IMPMAL_RTIM.VoidCombat.MP"}}){{/if}}</button>
                <button type="button" class="ship-combat-action" data-action="makeTest" data-type="ramming" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Ramming"}}"><i class="fa-solid fa-car-burst"></i>{{localize "IMPMAL_RTIM.VoidCombat.Ramming"}} 
                {{#if system.actionCosts.ramming.value}}(+{{system.actionCosts.ramming.value}} {{localize "IMPMAL_RTIM.VoidCombat.MP"}}){{/if}}</button>
                <button type="button" class="ship-combat-action" data-action="makeTest" data-type="silentRunning" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.SilentRunning"}}"><i class="fa-solid fa-user-ninja"></i>{{localize "IMPMAL_RTIM.VoidCombat.SilentRunning"}} 
                {{#if system.actionCosts.silentRunning.value}}({{system.actionCosts.silentRunning.value}} {{localize "IMPMAL_RTIM.VoidCombat.MP"}}){{/if}}</button>
                {{else}}
                <button type="button" class="ship-combat-action" data-action="makeTest" data-type="repairMinion" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.RepairMinion"}}"><i class="fa-solid fa-screwdriver-wrench"></i>{{localize "IMPMAL_RTIM.VoidCombat.RepairMinion"}}</button>
                <button type="button" class="ship-combat-action" data-action="makeTest" data-type="scanMinion" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.ScanMinion"}}"><i class="fa-solid fa-satellite-dish"></i>{{localize "IMPMAL_RTIM.VoidCombat.ScanMinion"}}</button>
                {{/if}}
            </div>
        </div>
    </div>
    {{#if criticalParts}}
    <div class="voidship-table-wrap">
        <div class="voidship-table" style="--voidship-table-cols: 1fr 1fr 0.2fr 3fr auto;">
            <div class="voidship-table-head">
                <div class="voidship-table-cell">{{localize "IMPMAL_RTIM.VoidCombat.Name"}}</div>
                <div class="voidship-table-cell voidship-table-center">{{localize "IMPMAL_RTIM.VoidCombat.CriticalType"}}</div>
                <div class="voidship-table-cell voidship-table-center">{{localize "IMPMAL_RTIM.VoidCombat.Level"}}</div>
                <div class="voidship-table-cell voidship-table-center">{{localize "IMPMAL_RTIM.VoidCombat.Effect"}}</div>
                    <div style="width:25px"></div>
            </div>
            {{#each criticalParts}}
            <div class="voidship-table-row-border voidship-table-row" data-uuid="{{this.uuid}}">
                <div class="voidship-table-cell voidship-text-left">
                    <div class="item-label-img"><img src="{{this.img}}"><label>{{this.name}}</label></div>
                </div>
                <div class="voidship-table-cell voidship-table-center">
                    {{localize (lookup (lookup (config "RTIM.voidship.criticalTypes") this.system.critical.type) "display")}}
                </div>
                <div class="voidship-table-cell voidship-table-center">{{this.system.critical.level}}</div>
                <div class="voidship-table-cell voidship-text-left">
                    {{this.system.effect}}
                </div>
                <div class="voidship-table-cell ship-weapon-actions voidship-table-center">
                    <div class="list-controls">
                        <a class="list-control context-menu"><i class="fa-regular fa-ellipsis-vertical"></i></a>
                    </div>
                </div>
                {{> sheetButtons document=this}}
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}
    <div class="ship-combat-grid">
        <div class="ship-combat-card">
            <div class="ship-combat-header">
                <div class="ship-stat-block">
                    <div class="ship-stat-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Hull"}}">{{localize "IMPMAL_RTIM.VoidCombat.Hull"}}</div>
                    <div class="ship-input-pair">
                        <input type="number" name="system.hull.value" value="{{system.hull.value}}">
                        <span>/</span>
                        <div>{{system.hull.max}}</div>
                        {{#if system.options.defyDeath.has}}
                        <button type="button" class="ship-part-action {{#if system.options.defyDeath.used}}danger{{/if}}" data-action="defyDeath" title="{{localize "IMPMAL_RTIM.VoidCombat.DefyDeath"}}" style="margin-left: 5px;">
                            <i class="fa-solid fa-hand-fist"></i>
                        </button>
                        {{/if}}
                    </div>
                </div>
                <div class="ship-stat-block">
                    <div class="ship-stat-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.OnFire"}}">{{localize "IMPMAL_RTIM.VoidCombat.onFire"}}</div>
                    <div class="ship-input-pair">
                        <input type="number" name="system.fire" value="{{system.fire}}">
                    </div>
                </div>
                {{#unless system.options.noFatigue}}
                <div class="ship-stat-block">
                    <div class="ship-stat-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Fatigue"}}">{{localize "IMPMAL_RTIM.VoidCombat.Fatigue"}}</div>
                    <div class="ship-input-pair">
                        <input type="number" name="system.fatigue.value" value="{{system.fatigue.value}}" min="0">
                        <span>/</span>
                        <div>{{system.fatigue.max}}</div>
                    </div>
                    {{#if isCrewRiots}}
                    <div class="ship-crew-riots" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.CrewRiots"}}">{{localize "IMPMAL_RTIM.VoidCombat.CrewRiots"}}</div>
                    {{else if isFatigued}}
                    <div class="ship-fatigued" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Fatigued"}}">{{localize "IMPMAL_RTIM.VoidCombat.Fatigued"}}</div>
                    {{/if}}
                </div>
                {{/unless}}        
            </div>
            <div class="ship-diagram">
                {{#unless (and system.options.takeAvgShield system.options.takeAvgArmour)}}
                <div class="ship-side ship-side-front">
                    <div class="ship-side-label">{{localize "IMPMAL_RTIM.VoidCombat.Fore"}}</div>
                    {{#unless system.options.takeAvgShield}}
                    <div class="ship-input-group">
                        <div class="ship-input-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Shields"}}">{{localize "IMPMAL_RTIM.VoidCombat.Shields"}}</div>
                        <div class="ship-input-pair">
                            <input type="number" name="system.shields.fore.value" value="{{system.shields.fore.value}}" >
                            <span>/</span>
                            <div>{{system.shields.fore.max}}</div>
                        </div>
                    </div>
                    {{/unless}}
                    {{#unless system.options.takeAvgArmour}}
                    <div class="ship-input-group">
                        <div class="ship-input-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Armour"}}">{{localize "IMPMAL_RTIM.VoidCombat.Armour"}}</div>
                        <div class="ship-input-pair">{{system.armour.fore.value}}</div>
                    </div>
                    {{/unless}}
                </div>
                <div class="ship-side ship-side-left">
                    <div class="ship-side-label">{{localize "IMPMAL_RTIM.VoidCombat.Port"}}</div>
                    {{#unless system.options.takeAvgShield}}
                    <div class="ship-input-group">
                        <div class="ship-input-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Shields"}}">{{localize "IMPMAL_RTIM.VoidCombat.Shields"}}</div>
                        <div class="ship-input-pair">
                            <input type="number" name="system.shields.port.value" value="{{system.shields.port.value}}" >
                            <span>/</span>
                            <div>{{system.shields.port.max}}</div>
                        </div>
                    </div>
                    {{/unless}}
                    {{#unless system.options.takeAvgArmour}}
                    <div class="ship-input-group">
                        <div class="ship-input-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Armour"}}">{{localize "IMPMAL_RTIM.VoidCombat.Armour"}}</div>
                        <div class="ship-input-pair">{{system.armour.port.value}}</div>
                    </div>
                    {{/unless}}
                </div>
                <div class="ship-side ship-side-right">
                    <div class="ship-side-label">{{localize "IMPMAL_RTIM.VoidCombat.Starboard"}}</div>
                    {{#unless system.options.takeAvgShield}}
                    <div class="ship-input-group">
                        <div class="ship-input-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Shields"}}">{{localize "IMPMAL_RTIM.VoidCombat.Shields"}}</div>
                        <div class="ship-input-pair">
                            <input type="number" name="system.shields.starboard.value" value="{{system.shields.starboard.value}}" >
                            <span>/</span>
                            <div>{{system.shields.starboard.max}}</div>
                        </div>
                    </div>
                    {{/unless}}
                    {{#unless system.options.takeAvgArmour}}
                    <div class="ship-input-group">
                        <div class="ship-input-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Armour"}}">{{localize "IMPMAL_RTIM.VoidCombat.Armour"}}</div>
                        <div class="ship-input-pair">{{system.armour.starboard.value}}</div>
                    </div>
                    {{/unless}}
                </div>
                <div class="ship-side ship-side-back">
                    <div class="ship-side-label">{{localize "IMPMAL_RTIM.VoidCombat.Aft"}}</div>
                    {{#unless system.options.takeAvgShield}}
                    <div class="ship-input-group">
                        <div class="ship-input-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Shields"}}">{{localize "IMPMAL_RTIM.VoidCombat.Shields"}}</div>
                        <div class="ship-input-pair">
                            <input type="number" name="system.shields.aft.value" value="{{system.shields.aft.value}}" >
                            <span>/</span>
                            <div>{{system.shields.aft.max}}</div>
                        </div>
                    </div>
                    {{/unless}}
                    {{#unless system.options.takeAvgArmour}}
                    <div class="ship-input-group">
                        <div class="ship-input-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.Armour"}}">{{localize "IMPMAL_RTIM.VoidCombat.Armour"}}</div>
                        <div class="ship-input-pair">{{system.armour.aft.value}}</div>
                    </div>
                    {{/unless}}
                </div>
                {{/unless}}
                {{#if system.options.takeAvgShield}}
                <div class="ship-side ship-side-average-shields">
                    <div class="ship-side-label">{{localize "IMPMAL_RTIM.VoidCombat.Shields"}}</div>
                    <div class="ship-input-group">
                        <div class="ship-input-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.ShieldsAverage"}}">{{localize "IMPMAL_RTIM.VoidCombat.Average"}}</div>
                        <div class="ship-input-pair">
                            <input type="number" name="system.shields.average.value" value="{{system.shields.average.value}}">
                            <span>/</span>
                            <div>{{system.shields.average.max}}</div>
                        </div>
                    </div>
                </div>
                {{/if}}
                {{#if system.options.takeAvgArmour}}
                <div class="ship-side ship-side-average-armour">
                    <div class="ship-side-label">{{localize "IMPMAL_RTIM.VoidCombat.Armour"}}</div>
                    <div class="ship-input-group">
                        <div class="ship-input-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.ArmourAverage"}}">{{localize "IMPMAL_RTIM.VoidCombat.Average"}}</div>
                        <div class="ship-input-pair">{{system.armour.average.value}}</div>
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
        <div class="ship-combat-card">
            <div class="ship-weapon-locations-header">
                <div class="ship-stat-label" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.WeaponLocations"}}">{{localize "IMPMAL_RTIM.VoidCombat.WeaponLocations"}}</div>
            </div>
            <div>
                {{#if hasWeaponSlots}}
                <div class="weapon-location-grid">
                    {{#if (gt weaponSlots.prow.value 0)}}
                    <div class="weapon-location-card arc-prow">
                        <div class="weapon-location-left">
                            <div class="weapon-location-sigil"></div>
                            <div class="weapon-location-label">{{localize "IMPMAL_RTIM.VoidCombat.Prow"}}</div>
                        </div>
                        <div class="weapon-location-right">
                            {{#each weaponSlots.prow.slots}}
                            <div class="weapon-slot-row">
                                <select name="system.weaponSlots.prow.assigned.{{@index}}">
                                    <option value="">{{localize "IMPMAL_RTIM.VoidCombat.None"}}</option>
                                    {{#each this.options}}
                                    <option value="{{value}}" {{#if (eq ../assigned value)}}selected{{/if}}>{{label}}</option>
                                    {{/each}}
                                </select>
                                {{#with (lookup @root.weaponById assigned)}}
                                {{> voidshipWeaponOptionsSheet}}
                                {{/with}}
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/if}}
                    {{#if (gt weaponSlots.port.value 0)}}
                    <div class="weapon-location-card arc-port">
                        <div class="weapon-location-left">
                            <div class="weapon-location-sigil"></div>
                            <div class="weapon-location-label">{{localize "IMPMAL_RTIM.VoidCombat.Port"}}</div>
                        </div>
                        <div class="weapon-location-right">
                            {{#each weaponSlots.port.slots}}
                            <div class="weapon-slot-row">
                                <select name="system.weaponSlots.port.assigned.{{@index}}">
                                    <option value="">{{localize "IMPMAL_RTIM.VoidCombat.None"}}</option>
                                    {{#each this.options}}
                                    <option value="{{value}}" {{#if (eq ../assigned value)}}selected{{/if}}>{{label}}</option>
                                    {{/each}}
                                </select>
                                {{#with (lookup @root.weaponById assigned)}}
                                {{> voidshipWeaponOptionsSheet}}
                                {{/with}}
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/if}}
                    {{#if (gt weaponSlots.starboard.value 0)}}
                    <div class="weapon-location-card arc-starboard">
                        <div class="weapon-location-left">
                            <div class="weapon-location-sigil"></div>
                            <div class="weapon-location-label">{{localize "IMPMAL_RTIM.VoidCombat.Starboard"}}</div>
                        </div>
                        <div class="weapon-location-right">
                            {{#each weaponSlots.starboard.slots}}
                            <div class="weapon-slot-row">
                                <select name="system.weaponSlots.starboard.assigned.{{@index}}">
                                    <option value="">{{localize "IMPMAL_RTIM.VoidCombat.None"}}</option>
                                    {{#each this.options}}
                                    <option value="{{value}}" {{#if (eq ../assigned value)}}selected{{/if}}>{{label}}</option>
                                    {{/each}}
                                </select>
                                {{#with (lookup @root.weaponById assigned)}}
                                {{> voidshipWeaponOptionsSheet}}
                                {{/with}}
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/if}}
                    {{#if (gt weaponSlots.aft.value 0)}}
                    <div class="weapon-location-card arc-aft">
                        <div class="weapon-location-left">
                            <div class="weapon-location-sigil"></div>
                            <div class="weapon-location-label">{{localize "IMPMAL_RTIM.VoidCombat.Aft"}}</div>
                        </div>
                        <div class="weapon-location-right">
                            {{#each weaponSlots.aft.slots}}
                            <div class="weapon-slot-row">
                                <select name="system.weaponSlots.aft.assigned.{{@index}}">
                                    <option value="">{{localize "IMPMAL_RTIM.VoidCombat.None"}}</option>
                                    {{#each this.options}}
                                    <option value="{{value}}" {{#if (eq ../assigned value)}}selected{{/if}}>{{label}}</option>
                                    {{/each}}
                                </select>
                                {{#with (lookup @root.weaponById assigned)}}
                                {{> voidshipWeaponOptionsSheet}}
                                {{/with}}
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/if}}
                    {{#if (gt weaponSlots.dorsal.value 0)}}
                    <div class="weapon-location-card arc-dorsal">
                        <div class="weapon-location-left">
                            <div class="weapon-location-sigil"></div>
                            <div class="weapon-location-label">{{localize "IMPMAL_RTIM.VoidCombat.Dorsal"}}</div>
                        </div>
                        <div class="weapon-location-right">
                            {{#each weaponSlots.dorsal.slots}}
                            <div class="weapon-slot-row">
                                <select name="system.weaponSlots.dorsal.assigned.{{@index}}">
                                    <option value="">{{localize "IMPMAL_RTIM.VoidCombat.None"}}</option>
                                    {{#each this.options}}
                                    <option value="{{value}}" {{#if (eq ../assigned value)}}selected{{/if}}>{{label}}</option>
                                    {{/each}}
                                </select>
                                {{#with (lookup @root.weaponById assigned)}}
                                {{> voidshipWeaponOptionsSheet}}
                                {{/with}}
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/if}}
                    {{#if (gt weaponSlots.keel.value 0)}}
                    <div class="weapon-location-card arc-keel">
                        <div class="weapon-location-left">
                            <div class="weapon-location-sigil"></div>
                            <div class="weapon-location-label">{{localize "IMPMAL_RTIM.VoidCombat.Keel"}}</div>
                        </div>
                        <div class="weapon-location-right">
                            {{#each weaponSlots.keel.slots}}
                            <div class="weapon-slot-row">
                                <select name="system.weaponSlots.keel.assigned.{{@index}}">
                                    <option value="">{{localize "IMPMAL_RTIM.VoidCombat.None"}}</option>
                                    {{#each this.options}}
                                    <option value="{{value}}" {{#if (eq ../assigned value)}}selected{{/if}}>{{label}}</option>
                                    {{/each}}
                                </select>
                                {{#with (lookup @root.weaponById assigned)}}
                                {{> voidshipWeaponOptionsSheet}}
                                {{/with}}
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/if}}
                </div>
                {{else}}
                <div class="ship-component-empty">{{localize "IMPMAL_RTIM.VoidCombat.NoWeaponSlots"}}</div>
                {{/if}}
            </div>
        </div>
    </div>
    {{#unless hasWeapons}}
    <div class="ship-component-empty">{{localize "IMPMAL_RTIM.VoidCombat.DragShipWeapon"}}</div>
    {{/unless}}
    {{#if macroWeapons}}
    <div class="voidship-table-wrap">
        <div class="ship-components-title">{{localize "IMPMAL_RTIM.VoidCombat.Macrobatteries"}}</div>
        <div class="voidship-table" style="--voidship-table-cols: 2fr 1fr 0.8fr 0.8fr 1fr auto;">
            <div class="voidship-table-head">
                <div class="voidship-table-cell">{{localize "IMPMAL_RTIM.VoidCombat.Name"}}</div>
                <div class="voidship-table-cell voidship-table-center">{{localize "IMPMAL_RTIM.VoidCombat.Damage"}}</div>
                <div class="voidship-table-cell voidship-table-center">{{localize "IMPMAL_RTIM.VoidCombat.WideArc"}}</div>
                <div class="voidship-table-cell voidship-table-center">{{localize "IMPMAL_RTIM.VoidCombat.Range"}}</div>
                <div class="voidship-table-cell voidship-table-center">{{localize "IMPMAL_RTIM.VoidCombat.Multipliers"}}</div>
                <div style="width:25px"></div>
            </div>
            {{#each macroWeapons}}
            <div class="voidship-table-row-border list-row" data-uuid="{{this.uuid}}">
                <div class="voidship-table-row">
                    <div class="voidship-table-cell ship-weapon-name" data-action="expandRow" data-collapseid="{{this.id}}">
                        <div class="item-label-img"><img src="{{this.img}}"><label>{{this.name}}</label></div>
                        {{#if (eq this.system.status "damaged")}}
                        <div class="weapon-slot-damaged">{{localize "IMPMAL_RTIM.VoidCombat.WeaponDamaged"}}</div>
                        {{/if}}
                        {{#if (eq this.system.status "destroyed")}}
                        <div class="weapon-slot-destroyed">{{localize "IMPMAL_RTIM.VoidCombat.WeaponDestroyed"}}</div>
                        {{/if}}
                        {{#unless system.active}}
                        <div class="weapon-slot-damaged">{{localize "IMPMAL_RTIM.VoidCombat.WeaponInactive"}}</div>
                        {{/unless}}
