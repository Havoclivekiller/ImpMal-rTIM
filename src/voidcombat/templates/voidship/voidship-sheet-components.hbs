<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">
    <div class="ship-components-section">
        <div class="ship-components-summary">
            <div class="ship-components-space" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.ShipPoints"}}">
                <label class="ship-components-label">{{localize "IMPMAL_RTIM.VoidCombat.ShipPoints"}}</label>
                <span class="ship-components-value">{{shipPointsTotal}}</span>
            </div>
        </div>
        <div class="ship-components-summary">
            <div class="ship-components-space" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.SpaceUsed"}}">
                <label class="ship-components-label">{{localize "IMPMAL_RTIM.VoidCombat.SpaceUsed"}}</label>
                <span class="ship-components-value">{{componentSpaceUsed}} / {{system.supplemental.value}}</span>
            </div>
        </div>
        <div class="ship-components-list">
        <h5 class="ship-components-subtitle" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.EssentialComponents"}}">{{localize "IMPMAL_RTIM.VoidCombat.EssentialComponents"}}</h5>
            {{#if essentialComponents.length}}
            {{#each essentialComponents}}
            <div class="ship-component-card list-row" data-uuid="{{this.uuid}}">
                <div class="ship-component-header">
                    <div class="ship-component-name" data-action="expandRow" data-collapseid="{{this.id}}"><img src="{{this.img}}"> <label>{{this.name}}</label></div>
                        {{#if (eq this.system.status "damaged")}}
                        <div class="weapon-slot-damaged">{{localize "IMPMAL_RTIM.VoidCombat.ComponentDamaged"}}</div>
                        {{/if}}
                        {{#if (eq this.system.status "destroyed")}}
                        <div class="weapon-slot-destroyed">{{localize "IMPMAL_RTIM.VoidCombat.ComponentDestroyed"}}</div>
                        {{/if}}
                        {{#unless system.active}}
                        <div class="weapon-slot-damaged">{{localize "IMPMAL_RTIM.VoidCombat.ComponentInactive"}}</div>
                        {{/unless}}
                    <div class="ship-component-meta"> 
                        {{#if (gt this.system.space 0)}}
                        <span class="ship-component-space">{{localize "IMPMAL_RTIM.VoidCombat.Space"}}: {{this.system.space}}</span>   
                        {{/if}}
                        {{#if (gt this.system.shipPoints 0)}}                         
                        <div class="points-pips" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.ComponentShipPoints"}}">
                            {{#times this.system.shipPoints}}
                            <span class="pip pip-active"></span>
                            {{/times}}
                        </div>
                        {{/if}}
                        <div class="list-controls">
                            <a class="list-control context-menu"><i class="fa-regular fa-ellipsis-vertical"></i></a>
                        </div>
                    </div>
                </div>
                <div class="dropdown-content {{#if (lookup ../collapsed this.id)}}collapsed{{else}}expanded{{/if}}">
                    <div class="ship-component-body">
                        {{#if this.system.effect}}
                        <div class="ship-component-block">
                            <div class="ship-component-label">{{localize "IMPMAL_RTIM.VoidCombat.Effect"}}</div>
                            <div class="ship-component-text">{{this.system.effect}}</div>
                        </div>
                        {{/if}}
                        {{#if this.system.displayChangeSummary}}
                        <div class="ship-component-block">
                            <div class="ship-component-label">{{localize "IMPMAL_RTIM.VoidCombat.Changes"}}</div>
                            <div class="ship-component-text">{{this.system.displayChangeSummary}}</div>
                        </div>
                        {{/if}}
                    </div>
                    {{#if this.system.notes.player}}
                    <div class="ship-component-body">
                        <div class="ship-component-block">
                            <div class="ship-component-label">{{localize "IMPMAL.Notes"}}</div>
                            <div class="ship-component-text">{{{this.system.notes.player}}}</div>
                        </div>
                    </div>
                    {{/if}}
                    {{#if (and this.system.notes.gm (isGM))}}
                    <div class="ship-component-body">
                        <div class="ship-component-block">
                            <div class="ship-component-label">{{localize "IMPMAL.GMNotes"}}</div>
                            <div class="ship-component-text">{{{this.system.notes.gm}}}</div>
                        </div>
                    </div>
                    {{/if}}
                    {{> sheetButtons document=this}}
                </div>
            </div>
            {{/each}}
            {{else}}
                <div class="ship-component-empty">{{localize "IMPMAL_RTIM.VoidCombat.None"}}</div>
            {{/if}}
        </div>
    </div>

    <div class="ship-components-section">
        <h5 class="ship-components-subtitle" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.SupplementalComponents"}}">{{localize "IMPMAL_RTIM.VoidCombat.SupplementalComponents"}} ({{localize "IMPMAL_RTIM.VoidCombat.Combat"}})</h5>
        <div class="ship-components-list">
