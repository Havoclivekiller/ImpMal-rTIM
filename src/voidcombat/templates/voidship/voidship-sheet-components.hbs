                                <div class="ship-component-label">{{localize "IMPMAL.GMNotes"}}</div>
                                <div class="ship-component-text">{{{this.system.notes.gm}}}</div>
                            </div>
                        </div>
                        {{/if}}
                    {{> sheetButtons document=this}}
                    </div>
                </div>
                {{/each}}
            {{else}}
                <div class="ship-component-empty">{{localize "IMPMAL_RTIM.VoidCombat.None"}}</div>
            {{/if}}
        </div>
        <h5 class="ship-components-subtitle" data-tooltip="{{localize "IMPMAL_RTIM.VoidCombat.Tooltip.NonCombatSupplementalComponents"}}">{{localize "IMPMAL_RTIM.VoidCombat.SupplementalComponents"}} ({{localize "IMPMAL_RTIM.VoidCombat.NonCombat"}})</h5>
