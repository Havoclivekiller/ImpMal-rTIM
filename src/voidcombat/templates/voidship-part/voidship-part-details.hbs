<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">
    {{#if (eq system.partType 'component')}}
        {{> voidshipComponentItem }}
    {{/if}}
    {{#if (eq system.partType 'weapon')}}
        {{> voidshipWeaponItem }}
    {{/if}}
    {{#if (eq system.partType 'hull')}}
        {{> voidshipHullItem }}
    {{/if}}
    {{#if (eq system.partType 'role')}}
        {{> voidshipRoleItem }}
    {{/if}}
    {{#if (eq system.partType 'trait')}}
        {{> voidshipTraitItem }}
    {{/if}}
    {{#if (eq system.partType 'critical')}}
        {{> voidshipCriticalItem }}
    {{/if}}
</section>
