
    <div class="form-group">
        <label>{{localize "IMPMAL_RTIM.VoidCombat.CriticalType"}}</label>
        <div class="form-fields">
            <select name="system.critical.type" {{#if parent.actor}} disabled{{/if}}>
                {{selectOptions (config "RTIM.voidship.criticalTypes") selected=this.system.critical.type labelAttr="display" localize=true}}
            </select>
        </div>
    </div>

    <div class="form-group stacked">
        <label>{{localize "IMPMAL_RTIM.VoidCombat.Effect"}}</label>
        <div class="form-fields">
            <textarea name="system.effect">{{system.effect}}</textarea>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "IMPMAL_RTIM.VoidCombat.Level"}}</label>
        <div class="form-fields">
            <input type="number" name="system.critical.level" value="{{system.critical.level}}">
        </div>
    </div>
