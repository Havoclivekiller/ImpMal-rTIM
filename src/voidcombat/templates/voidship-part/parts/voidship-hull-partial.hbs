
    <div class="form-group">
        <label>{{localize "IMPMAL_RTIM.VoidCombat.HullType"}}</label>
        <div class="form-fields">
            <select name="system.hull.type" {{#if parent.actor}}disabled{{/if}}>
                {{#select system.hull.type}}
                    {{#each (config "RTIM.voidship.hullTypes")}}
                    <option value="{{this.key}}">{{this.display}}</option>
                    {{/each}}
                {{/select}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "IMPMAL_RTIM.VoidCombat.Hull"}}</label>
        <div class="form-fields">
            <input type="number" name="system.hull.value" value="{{system.hull.value}}">
        </div>
    </div>

