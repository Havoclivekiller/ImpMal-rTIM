<div class="attack-fields">
    <div class="voidship dialog-voidship">
        <div class="voidship-duel">
            <div class="voidship-duel-side voidship-duel-side-attacker">
                <div class="voidship-duel-stats">
                    <div class="voidship-duel-stat">
                        <div class="voidship-duel-radios">
                            <label class="voidship-duel-choice">
                                <input type="radio" name="useDetectionMode" value="none" {{checked (eq fields.useDetectionMode "none")}}>
                                <i class="fa-solid fa-x"></i>
                            </label>
                            <label class="voidship-duel-choice" data-tooltip="{{localize 'IMPMAL_RTIM.VoidCombat.DetectionRating'}} ({{localize 'IMPMAL_RTIM.VoidCombat.Half'}})">
                                <input type="radio" name="useDetectionMode" value="half" {{checked (eq fields.useDetectionMode "half")}}>
                                <i class="fa-light fa-satellite-dish"></i>
                            </label>
                            <label class="voidship-duel-choice" data-tooltip="{{localize 'IMPMAL_RTIM.VoidCombat.DetectionRating'}} ({{localize 'IMPMAL_RTIM.VoidCombat.Full'}})">
                                <input type="radio" name="useDetectionMode" value="full" {{checked (eq fields.useDetectionMode "full")}}>
                                <i class="fa-solid fa-satellite-dish"></i>
                            </label>
                        </div>
                    </div>
                    <div class="voidship-duel-stat">
                        <div class="voidship-duel-radios">
                            <label class="voidship-duel-choice">
                                <input type="radio" name="useEvasionMode" value="none" {{checked (eq fields.useEvasionMode "none")}}>
                                <i class="fa-solid fa-x"></i>
                            </label>
                            <label class="voidship-duel-choice" data-tooltip="{{localize 'IMPMAL_RTIM.VoidCombat.EvasionRating'}} ({{localize 'IMPMAL_RTIM.VoidCombat.Half'}})">
                                <input type="radio" name="useEvasionMode" value="half" {{checked (eq fields.useEvasionMode "half")}}>
                                <i class="fa-light fa-up-down-left-right"></i>
                            </label>
                            <label class="voidship-duel-choice" data-tooltip="{{localize 'IMPMAL_RTIM.VoidCombat.EvasionRating'}} ({{localize 'IMPMAL_RTIM.VoidCombat.Full'}})">
                                <input type="radio" name="useEvasionMode" value="full" {{checked (eq fields.useEvasionMode "full")}}>
                                <i class="fa-solid fa-up-down-left-right"></i>
                            </label>
                        </div>
                    </div>
                    <div class="voidship-duel-stat">
                        <div class="voidship-duel-radios">
                            <label class="voidship-duel-choice">
                                <input type="radio" name="useTurretMode" value="none" {{checked (eq fields.useTurretMode "none")}}>
                                <i class="fa-solid fa-x"></i>
                            </label>
                            <label class="voidship-duel-choice" data-tooltip="{{localize 'IMPMAL_RTIM.VoidCombat.TurretRating'}} ({{localize 'IMPMAL_RTIM.VoidCombat.Half'}})">
                                <input type="radio" name="useTurretMode" value="half" {{checked (eq fields.useTurretMode "half")}}>
                                <i class="fa-light fa-tower-observation"></i>
                            </label>
                            <label class="voidship-duel-choice" data-tooltip="{{localize 'IMPMAL_RTIM.VoidCombat.TurretRating'}} ({{localize 'IMPMAL_RTIM.VoidCombat.Full'}})">
                                <input type="radio" name="useTurretMode" value="full" {{checked (eq fields.useTurretMode "full")}}>
                                <i class="fa-solid fa-tower-observation"></i>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="voidship-duel-ship">
                    <img class="voidship-duel-ship-image" src="{{data.actorImg}}" alt="{{data.actorName}}">
                </div>
            </div>
                {{#if data.targetName}}
            <div class="voidship-duel-side voidship-duel-side-target">
                <div class="voidship-duel-stats">
                    <div class="voidship-duel-stat">
                        <div class="voidship-duel-radios" role="radiogroup">
                            <label class="voidship-duel-choice">
                                <input type="radio" name="useTargetDetectionMode" value="none" {{checked (eq fields.useTargetDetectionMode "none")}}>
                                <i class="fa-solid fa-x"></i>
                            </label>
                            <label class="voidship-duel-choice" data-tooltip="{{localize 'IMPMAL_RTIM.VoidCombat.DetectionRating'}} ({{localize 'IMPMAL_RTIM.VoidCombat.Half'}})">
                                <input type="radio" name="useTargetDetectionMode" value="half" {{checked (eq fields.useTargetDetectionMode "half")}}>
                                <i class="fa-light fa-satellite-dish"></i>
                            </label>
                            <label class="voidship-duel-choice" data-tooltip="{{localize 'IMPMAL_RTIM.VoidCombat.DetectionRating'}} ({{localize 'IMPMAL_RTIM.VoidCombat.Full'}})">
                                <input type="radio" name="useTargetDetectionMode" value="full" {{checked (eq fields.useTargetDetectionMode "full")}}>
                                <i class="fa-solid fa-satellite-dish"></i>
                            </label>
                        </div>
                    </div>
                    <div class="voidship-duel-stat">
                        <div class="voidship-duel-radios" role="radiogroup">
                            <label class="voidship-duel-choice">
                                <input type="radio" name="useTargetEvasionMode" value="none" {{checked (eq fields.useTargetEvasionMode "none")}}>
                                <i class="fa-solid fa-x"></i>
                            </label>
                            <label class="voidship-duel-choice" data-tooltip="{{localize 'IMPMAL_RTIM.VoidCombat.EvasionRating'}} ({{localize 'IMPMAL_RTIM.VoidCombat.Half'}})">
                                <input type="radio" name="useTargetEvasionMode" value="half" {{checked (eq fields.useTargetEvasionMode "half")}}>
                                <i class="fa-light fa-up-down-left-right"></i>
                            </label>
                            <label class="voidship-duel-choice" data-tooltip="{{localize 'IMPMAL_RTIM.VoidCombat.EvasionRating'}} ({{localize 'IMPMAL_RTIM.VoidCombat.Full'}})">
                                <input type="radio" name="useTargetEvasionMode" value="full" {{checked (eq fields.useTargetEvasionMode "full")}}>
                                <i class="fa-solid fa-up-down-left-right"></i>
                            </label>
                        </div>
                    </div>
                    <div class="voidship-duel-stat">
                        <div class="voidship-duel-radios" role="radiogroup">
                            <label class="voidship-duel-choice">
                                <input type="radio" name="useTargetTurretMode" value="none" {{checked (eq fields.useTargetTurretMode "none")}}>
                                <i class="fa-solid fa-x"></i>
                            </label>
                            <label class="voidship-duel-choice" data-tooltip="{{localize 'IMPMAL_RTIM.VoidCombat.TurretRating'}} ({{localize 'IMPMAL_RTIM.VoidCombat.Half'}})">
                                <input type="radio" name="useTargetTurretMode" value="half" {{checked (eq fields.useTargetTurretMode "half")}}>
                                <i class="fa-light fa-tower-observation"></i>
                            </label>
                            <label class="voidship-duel-choice" data-tooltip="{{localize 'IMPMAL_RTIM.VoidCombat.TurretRating'}} ({{localize 'IMPMAL_RTIM.VoidCombat.Full'}})">
                                <input type="radio" name="useTargetTurretMode" value="full" {{checked (eq fields.useTargetTurretMode "full")}}>
                                <i class="fa-solid fa-tower-observation"></i>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="voidship-duel-ship">
                    <img class="voidship-duel-ship-image" src="{{data.targetImg}}" alt="{{data.targetName}}">
                </div>
            </div>
                {{/if}}
        </div>
    </div>
    {{#if fields.hasHalfRange}}
    <div class="form-group">
        <label>{{localize 'IMPMAL_RTIM.VoidCombat.HalfRange'}} </label>
        <div class="form-fields">
            <label>{{localize "IMPMAL.Advantage"}}</label><input type="checkbox" name="useHalfRange" {{checked fields.useHalfRange}}>
        </div>
    </div>
    {{/if}}
    {{#if fields.hasWeaponDamaged}}
    <div class="form-group">
        <label>{{localize 'IMPMAL_RTIM.VoidCombat.WeaponDamaged'}} </label>
        <div class="form-fields">
            <label>{{localize "IMPMAL.Disadvantage"}}</label><input type="checkbox" name="useWeaponDamaged" {{checked fields.useWeaponDamaged}}>
        </div>
    </div>
    {{/if}}
    {{#if fields.hasWeaponRating}}
    <div class="form-group">
        <label>{{localize 'IMPMAL_RTIM.VoidCombat.WeaponRating'}} </label>
        <div class="form-fields">
            <label>{{fields.weaponRating}}</label><input type="checkbox" name="useWeaponRating" {{checked fields.useWeaponRating}}>
        </div>
    </div>
    {{/if}}
    {{#if fields.hasHitLocation}}
    <div class="form-group">
        <label>{{localize "IMPMAL.HitLocation"}}</label>
        <div class="form-fields">
            <select name="hitLocation">
                {{selectOptions data.hitLocations selected=fields.hitLocation localize="true"}}
            </select>
        </div>
    </div>
    {{/if}}
    {{#if fields.hasDamage}}
    <div class="form-group" {{#if tooltips.damage}}data-tooltip-direction="LEFT" data-tooltip="{{tooltips.damage}}"
        {{/if}}>
        <label>{{localize "IMPMAL.Damage"}} +/-</label>
        <div class="form-fields">
            <input type="number" name="damage" value="{{fields.damage}}">
        </div>
    </div>
    {{/if}}
    {{#if fields.hasSelfDamage}}
    <div class="form-group">
        <label>{{localize "IMPMAL_RTIM.VoidCombat.SelfDamage"}} +/-</label>
        <div class="form-fields">
            <input type="number" name="selfDamage" value="{{fields.selfDamage}}">
        </div>
    </div>
    {{/if}}
    {{#if fields.dogfight}}
    <div class="form-group">
        <label>{{localize 'IMPMAL_RTIM.VoidCombat.AlliedSquadronsIn2'}} </label>
        <div class="form-fields">
            <input type="number" name="alliedSquadrons" value="{{fields.alliedSquadrons}}">
        </div>
    </div>
    {{/if}}
    {{#if fields.dogfightOpposed}}
    <div class="form-group">
        <label>{{localize 'IMPMAL_RTIM.VoidCombat.EscortSquadrons'}} </label>
        <div class="form-fields">
            <input type="number" name="escortingSquadrons" value="{{fields.escortingSquadrons}}">
        </div>
    </div>
    {{/if}}
</div>
